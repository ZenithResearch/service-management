    },
    "client_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "request_id",
        "idempotency_key",
        "provider_id",
        "service_id",
        "transport",
        "service_request",
        "case",
        "execution",
        "deliverables",
        "receipts",
        "updated_at",
        "retry_after_ms"
      ],
      "properties": {
        "schema": {
          "const": "service.client-projection.v1"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "provider_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "service_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "transport": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "receipt"
          ],
          "properties": {
            "state": {
              "enum": [
                "pending",
                "consumed",
                "expired",
                "failed"
              ]
            },
            "receipt": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "transport",
                    "receipt_id",
                    "recorded_at",
                    "expires_at"
                  ],
                  "properties": {
                    "transport": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 16384
                    },
                    "receipt_id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
                    },
                    "recorded_at": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 16384
                    },
                    "expires_at": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 4096
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "service_request": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "state",
                "version",
                "case_id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
                },
                "state": {
                  "enum": [
                    "intake",
                    "qualified",
                    "accepted",
                    "rejected"
                  ]
                },
                "version": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "case_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
                    },
