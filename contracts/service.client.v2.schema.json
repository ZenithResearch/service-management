    "artifact_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "artifact_id",
        "content_hash",
        "byte_length",
        "media_type",
        "filename"
      ],
      "properties": {
        "schema": {
          "const": "service.artifact-manifest.v1"
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      }
    },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "request_id",
        "idempotency_key",
        "service",
        "brief",
        "references",
        "submitted_at"
      ],
      "properties": {
        "schema": {
          "const": "service.intake.v1"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider_id",
            "service_id",
            "service_version"
          ],
          "properties": {
            "provider_id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
            },
            "service_id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
            },
            "service_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            }
          }
        },
        "brief": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "revision",
            "content_hash",
            "values"
          ],
          "properties": {
            "schema": {
              "const": "service.reviewed-brief.v1"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "content_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "values": {
              "type": "object",
              "maxProperties": 128
            }
          }
        },
        "references": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema",
              "artifact_id",
              "content_hash",
              "byte_length",
              "media_type",
              "filename"
            ],
            "properties": {
              "schema": {
                "const": "service.artifact-manifest.v1"
              },
              "artifact_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
              },
              "content_hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "byte_length": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "media_type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "filename": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              }
            }
          }
        },
        "submitted_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      }
    },
    "intake_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "request_id",
        "idempotency_key",
        "state",
        "transport_receipt",
        "service_request_id",
        "service_request_version",
        "status_url"
      ],
      "properties": {
        "schema": {
          "const": "service.intake-result.v1"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "state": {
          "enum": [
            "pending",
            "admitted",
            "rejected"
          ]
        },
        "transport_receipt": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "transport",
                "receipt_id",
                "recorded_at",
                "expires_at"
              ],
              "properties": {
                "transport": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384
                },
                "receipt_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
                },
                "recorded_at": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384
                },
                "expires_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 4096
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "service_request_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "service_request_version": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "status_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
