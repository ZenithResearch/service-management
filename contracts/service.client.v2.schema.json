                  ]
                }
              }
            }
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "submission",
            "status",
            "artifacts"
          ],
          "properties": {
            "submission": {
              "const": "receiver-issued"
            },
            "status": {
              "const": "receiver-issued"
            },
            "artifacts": {
              "const": "receiver-issued"
            }
          }
        },
        "intake": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "endpoint",
            "max_retention_seconds",
            "envelope"
          ],
          "properties": {
            "endpoint": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "max_retention_seconds": {
              "type": "integer",
              "minimum": 60,
              "maximum": 604800
            },
            "envelope": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schema",
                "algorithm",
                "recipient_key_id",
                "recipient_public_key_hex",
                "not_before",
                "not_after"
              ],
              "properties": {
                "schema": {
                  "const": "service.intake-envelope.v1"
                },
                "algorithm": {
                  "const": "x25519-hkdf-sha256-chacha20poly1305"
                },
                "recipient_key_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255,
                  "pattern": "^[!-~]+$"
                },
                "recipient_public_key_hex": {
                  "type": "string",
