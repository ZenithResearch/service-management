                    "max_bytes"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
