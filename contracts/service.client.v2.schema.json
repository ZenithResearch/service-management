              "expected_deliverables": {
                "type": "array",
                "maxItems": 128,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "label",
                    "media_types",
                    "multiple"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 16384
                    },
                    "media_types": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 32,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 16384
                      }
                    },
                    "multiple": {
                      "type": "boolean"
                    }
                  }
                }
              },
              "process": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "process_id",
                      "process_version",
                      "compilation_hash"
                    ],
                    "properties": {
                      "process_id": {
                        "type": "string",
                        "minLength": 1,
