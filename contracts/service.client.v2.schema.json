{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:service-management:client:v2",
  "title": "Service Management browser client contracts v2",
  "$defs": {
    "provider_catalog": {
      "oneOf": [
        {
          "$ref": "#/$defs/provider_catalog_v1"
        },
        {
          "$ref": "#/$defs/provider_catalog_v2"
        }
      ]
    },
    "provider_catalog_v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "provider",
        "services",
        "authority"
      ],
      "properties": {
        "schema": {
          "const": "service.provider-catalog.v1"
        },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            }
          }
        },
        "services": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "name",
              "summary",
              "availability",
              "inputs",
              "accepted_references",
              "expected_deliverables",
              "process",
              "communication"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "availability": {
                "enum": [
                  "available",
                  "paused",
                  "preview"
                ]
              },
              "inputs": {
                "type": "array",
                "maxItems": 128,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "label",
                    "type",
                    "required",
                    "description",
                    "max_length"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 16384
                    },
                    "type": {
                      "enum": [
                        "string",
                        "integer",
                        "number",
                        "boolean"
                      ]
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 4096
                    },
                    "max_length": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 16384
                    }
                  }
                }
              },
              "accepted_references": {
                "type": "array",
                "maxItems": 128,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "label",
                    "required",
                    "media_types",
                    "max_bytes"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 16384
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "media_types": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 32,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 16384
                      }
                    },
                    "max_bytes": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1073741824
                    }
                  }
                }
              },
              "expected_deliverables": {
                "type": "array",
                "maxItems": 128,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "label",
                    "media_types",
                    "multiple"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 16384
                    },
                    "media_types": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 32,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 16384
                      }
                    },
                    "multiple": {
                      "type": "boolean"
                    }
                  }
                }
              },
              "process": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "process_id",
                      "process_version",
                      "compilation_hash"
                    ],
                    "properties": {
                      "process_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 16384
                      },
                      "process_version": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 16384
                      },
                      "compilation_hash": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "communication": {
                "type": "array",
                "maxItems": 2,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "provider-status",
                    "matrix"
                  ]
                }
              }
            }
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "submission",
            "status",
            "artifacts"
          ],
          "properties": {
            "submission": {
              "const": "receiver-issued"
            },
            "status": {
              "const": "receiver-issued"
            },
            "artifacts": {
              "const": "receiver-issued"
            }
          }
        }
      }
    },
