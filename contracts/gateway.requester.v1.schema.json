{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:service-management:gateway-requester:v1",
  "title": "Encrypted intake gateway requester contracts v1",
  "$defs": {
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "provider_id",
        "request_id",
        "idempotency_key",
        "intake_digest_sha256",
        "envelope_digest_sha256",
        "recipient_key_id",
        "envelope_expires_at_ms"
      ],
      "properties": {
        "schema": {
          "const": "service.encrypted-intake-authorization.v1"
        },
        "provider_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "intake_digest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "envelope_digest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "recipient_key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[!-~]+$"
        },
        "envelope_expires_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "presentation_request",
        "presentation"
      ],
      "properties": {
        "schema": {
          "const": "service.castalia-gateway-presentation.v1"
        },
        "presentation_request": {
          "$ref": "requester.evidence.v1.schema.json#/$defs/presentationRequest"
        },
        "presentation": {
          "$ref": "requester.evidence.v1.schema.json#/$defs/presentation"
        }
      }
    }
  }
}
