{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:service-management:castalia-requester-policy:v1",
  "title": "service.castalia-requester-policy.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "membership_roots", "presentation_pins", "policy_digest_sha256", "trusted_transports"],
  "properties": {
    "schema": {"const": "service.castalia-requester-policy.v1"},
    "membership_roots": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["issuer_id", "key_id", "public_key_hex"],
        "properties": {
          "issuer_id": {"type": "string"}, "key_id": {"type": "string"},
          "public_key_hex": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "presentation_pins": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["issuer", "key_id", "public_key_hex", "audience", "callers"],
        "properties": {
          "issuer": {"type": "string"}, "key_id": {"type": "string"},
          "public_key_hex": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "audience": {"type": "string"},
          "callers": {"type": "array", "minItems": 1, "items": {
            "type": "array", "prefixItems": [{"enum": ["browser", "terminal"]}, {"type": "string"}],
            "items": false, "minItems": 2, "maxItems": 2
          }}
        }
      }
    },
    "policy_digest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "trusted_transports": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string"}}
  }
}
