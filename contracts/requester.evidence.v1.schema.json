{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:service-management:castalia-requester-evidence:v1",
  "title": "service.castalia-requester-evidence.v1",
  "$comment": "The reader also verifies both Ed25519 signatures, deterministic membership ID, exact canonical intake bytes and digests, receiver trust pins, and proof validity at an authenticated transport receipt time.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "membership", "presentation_request", "presentation"],
  "properties": {
    "schema": {"const": "service.castalia-requester-evidence.v1"},
    "membership": {"$ref": "#/$defs/membership"},
    "presentation_request": {"$ref": "#/$defs/presentationRequest"},
    "presentation": {"$ref": "#/$defs/presentation"}
  },
  "$defs": {
    "hex32": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hex16": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "hex64": {"type": "string", "pattern": "^[0-9a-f]{128}$"},
    "time": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "caller": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id"],
      "properties": {"kind": {"enum": ["browser", "terminal"]}, "id": {"type": "string", "minLength": 1, "maxLength": 200}}
    },
    "membership": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "version", "membershipId", "ownerPublicKey", "status", "issuerId", "issuerKeyId", "signatureSuite", "issuerSignature"],
      "properties": {
        "schema": {"const": "castalia.zenith-membership-credential.v3"}, "version": {"const": 3},
        "membershipId": {"$ref": "#/$defs/hex32"}, "ownerPublicKey": {"$ref": "#/$defs/hex32"},
        "status": {"const": "active"}, "issuerId": {"type": "string", "minLength": 1, "maxLength": 64},
        "issuerKeyId": {"type": "string", "minLength": 1, "maxLength": 64}, "signatureSuite": {"const": "Ed25519"},
        "issuerSignature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
      }
    },
    "disclosure": {
      "type": "object", "additionalProperties": false, "required": ["title", "statements"],
      "properties": {"title": {"type": "string", "minLength": 1, "maxLength": 160}, "statements": {"type": "array", "minItems": 1, "maxItems": 144, "items": {"type": "string", "minLength": 1, "maxLength": 512}}}
    },
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "issuer", "key_id", "holder_public_key", "audience", "caller", "request_digest_sha256", "disclosure_digest_sha256", "policy_digest_sha256", "nonce", "issued_at", "expires_at"],
      "properties": {
        "schema": {"const": "castalia.request-credential.v1"}, "issuer": {"type": "string", "minLength": 1, "maxLength": 200},
        "key_id": {"type": "string", "minLength": 1, "maxLength": 200}, "holder_public_key": {"$ref": "#/$defs/hex32"},
        "audience": {"type": "string", "minLength": 1, "maxLength": 200}, "caller": {"$ref": "#/$defs/caller"},
        "request_digest_sha256": {"$ref": "#/$defs/hex32"}, "disclosure_digest_sha256": {"$ref": "#/$defs/hex32"},
        "policy_digest_sha256": {"$ref": "#/$defs/hex32"}, "nonce": {"$ref": "#/$defs/hex16"},
        "issued_at": {"$ref": "#/$defs/time"}, "expires_at": {"$ref": "#/$defs/time"}
      }
    },
    "credential": {
      "type": "object", "additionalProperties": false, "required": ["claims", "signature"],
      "properties": {"claims": {"$ref": "#/$defs/claims"}, "signature": {"$ref": "#/$defs/hex64"}}
    },
    "presentationRequest": {
      "type": "object", "additionalProperties": false, "required": ["schema", "request_bytes_base64", "disclosure", "credential"],
      "properties": {
        "schema": {"const": "castalia.credential-presentation-request.v2"},
        "request_bytes_base64": {"type": "string", "minLength": 4, "maxLength": 174764, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"},
        "disclosure": {"$ref": "#/$defs/disclosure"}, "credential": {"$ref": "#/$defs/credential"}
      }
    },
    "presentation": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "holder_public_key", "issuer", "key_id", "audience", "caller", "request_digest_sha256", "credential_digest_sha256", "disclosure_digest_sha256", "nonce", "issued_at", "expires_at", "signature"],
      "properties": {
        "schema": {"const": "castalia.credential-presentation.v2"}, "holder_public_key": {"$ref": "#/$defs/hex32"},
        "issuer": {"type": "string", "minLength": 1, "maxLength": 200}, "key_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "audience": {"type": "string", "minLength": 1, "maxLength": 200}, "caller": {"$ref": "#/$defs/caller"},
        "request_digest_sha256": {"$ref": "#/$defs/hex32"}, "credential_digest_sha256": {"$ref": "#/$defs/hex32"},
        "disclosure_digest_sha256": {"$ref": "#/$defs/hex32"}, "nonce": {"$ref": "#/$defs/hex16"},
        "issued_at": {"$ref": "#/$defs/time"}, "expires_at": {"$ref": "#/$defs/time"}, "signature": {"$ref": "#/$defs/hex64"}
      }
    }
  }
}
